# EVOS — Environment Variables
# Copy this to .env and fill in values

# Database
DATABASE_URL=postgresql+asyncpg://evos_user:evos_pass@localhost:5432/evos_db

# ML
DATASET_PATH=data/electric_vehicles_dataset.csv
ML_MODEL_PATH=models/evos_pipeline.pkl
ML_KMEANS_CLUSTERS=3
ML_TOP_K=5

# App
DEBUG=false
ALLOWED_ORIGINS=["http://localhost:3000","https://yourdomain.com"]

# Frontend
VITE_API_URL=http://localhost:8000
